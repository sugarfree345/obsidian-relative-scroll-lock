{
  "name": "obsidian-relative-scroll-lock-strict",
  "version": "1.2.2",
  "private": true,
  "description": "One-click continuous two-column reading and strict relative scroll locking for Obsidian Markdown panes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sugarfree345/obsidian-relative-scroll-lock.git"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser-scroll.cjs",
    "test:browser:native": "node tests/browser-native-input.cjs",
    "test:app:native": "node tests/native-real-app.cjs",
    "check": "npm test && npm run build && node scripts/verify-release.cjs",
    "package": "npm run check && node scripts/package.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.1"
  },
  "engines": {
    "node": ">=20"
  }
}
